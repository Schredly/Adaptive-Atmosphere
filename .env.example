# ─────────────────────────────────────────────────────────────
# Adaptive Atmosphere — environment configuration
# Copy to `.env` and fill in. All client-exposed vars MUST be
# prefixed with VITE_ (Vite only exposes those to the browser).
# ─────────────────────────────────────────────────────────────

# Spotify Web API / Web Playback SDK (OAuth PKCE flow)
# Create an app at https://developer.spotify.com/dashboard
# Leave CLIENT_ID blank to stay in Demo mode (no login required).
#
# NOTE: Spotify only allows `https://` redirect URIs OR the loopback IP
# `http://127.0.0.1:<port>` (NOT `http://localhost`). For local dev, register
# the URI below in your Spotify app's "Redirect URIs" and open the app at
# http://127.0.0.1:5173 (Vite serves both localhost and 127.0.0.1).
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/spotify/callback
VITE_SPOTIFY_SCOPES=user-read-playback-state user-modify-playback-state streaming user-read-email user-read-private playlist-read-private playlist-read-collaborative

# Web Playback SDK requires a Spotify Premium account.

# Motion / vision engine
#   mock = cinematic simulated motion (no camera required)
#   live = MediaPipe Pose driven by the active camera feed
VITE_MOTION_SOURCE=mock

# MediaPipe Pose landmarker model (served by Google CDN by default).
VITE_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task

# Pose inference backend: GPU (fast, default) or CPU.
#   Leave on GPU — if the GPU delegate loads but returns no skeletons (a known
#   issue on some macOS GPUs), the app auto-falls-back to CPU after ~1s. Set CPU
#   to skip GPU entirely if your machine never detects on GPU.
VITE_POSE_DELEGATE=GPU
